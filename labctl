#!/usr/bin/env bash

set -uo pipefail

readonly LABCTL_VERSION="2.3.0-dev"
readonly LABCTL_REPOSITORY="RavenAsakura/labctl"
readonly LABCTL_LICENSE="MIT"

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]:-$0}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"

readonly SCRIPT_DIR
readonly MODULES_DIR="$SCRIPT_DIR/modules"
readonly HEALTH_SCRIPT="$SCRIPT_DIR/labctl.health.backup"

load_module() {
    local module_name="${1:?Missing module name}"
    local module_file="$MODULES_DIR/${module_name}.sh"

    if [[ ! -r "$module_file" ]]; then
        printf '[ERROR] Module not found: %s\n' "$module_name" >&2
        return 1
    fi

    # Modules are discovered at runtime from the trusted project directory.
    # shellcheck source=/dev/null
    source "$module_file"
}

list_modules() {
    local module_file
    local module_name
    local counter=1
    local -a modules=()

    shopt -s nullglob

    for module_file in "$MODULES_DIR"/*.sh; do
        module_name="$(basename "$module_file" .sh)"

        [[ "$module_name" == "utils" ]] && continue

        modules+=("$module_name")
    done

    shopt -u nullglob

    if (( ${#modules[@]} == 0 )); then
        echo "  No modules installed."
        return 0
    fi

    while IFS= read -r module_name; do
        [[ -n "$module_name" ]] || continue
        printf '  %2d. %s\n' "$counter" "$module_name"
        counter=$((counter + 1))
    done < <(printf '%s\n' "${modules[@]}" | sort)
}

count_modules() {
    local module_file
    local module_name
    local count=0

    shopt -s nullglob

    for module_file in "$MODULES_DIR"/*.sh; do
        module_name="$(basename "$module_file" .sh)"

        [[ "$module_name" == "utils" ]] && continue

        count=$((count + 1))
    done

    shopt -u nullglob

    printf '%s\n' "$count"
}

git_branch() {
    git -C "$SCRIPT_DIR" branch --show-current 2>/dev/null ||
        printf 'Unavailable\n'
}

git_commit() {
    git -C "$SCRIPT_DIR" rev-parse --short HEAD 2>/dev/null ||
        printf 'Unavailable\n'
}

git_latest_tag() {
    git -C "$SCRIPT_DIR" describe \
        --tags \
        --abbrev=0 \
        2>/dev/null ||
        printf 'No tags\n'
}

git_remote() {
    local remote_url

    remote_url="$(
        git -C "$SCRIPT_DIR" remote get-url origin 2>/dev/null ||
        true
    )"

    case "$remote_url" in
        git@github.com:*)
            remote_url="${remote_url#git@github.com:}"
            remote_url="${remote_url%.git}"
            printf '%s\n' "$remote_url"
            ;;
        https://github.com/*)
            remote_url="${remote_url#https://github.com/}"
            remote_url="${remote_url%.git}"
            printf '%s\n' "$remote_url"
            ;;
        "")
            printf '%s\n' "$LABCTL_REPOSITORY"
            ;;
        *)
            printf '%s\n' "$remote_url"
            ;;
    esac
}

operating_system_name() {
    if [[ -r /etc/os-release ]]; then
        . /etc/os-release
        printf '%s\n' "${PRETTY_NAME:-Unknown}"
    else
        printf 'Unknown\n'
    fi
}

hardware_value() {
    local file="${1:?Missing hardware information file}"

    if [[ -r "$file" ]]; then
        tr -d '\0' < "$file" |
            sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
    else
        printf 'Unknown\n'
    fi
}

labctl_about() {
    local branch
    local commit
    local latest_tag
    local module_count
    local operating_system
    local kernel
    local architecture
    local repository
    local hardware_vendor
    local hardware_model

    branch="$(git_branch)"
    commit="$(git_commit)"
    latest_tag="$(git_latest_tag)"
    module_count="$(count_modules)"
    operating_system="$(operating_system_name)"
    kernel="$(uname -r)"
    architecture="$(uname -m)"
    repository="$(git_remote)"
    hardware_vendor="$(hardware_value /sys/class/dmi/id/sys_vendor)"
    hardware_model="$(hardware_value /sys/class/dmi/id/product_name)"

    print_header "LABCTL INFORMATION"

    print_status_value "Version:" "$LABCTL_VERSION" "info"
    print_status_value "Repository:" "$repository" "normal"
    print_status_value "Branch:" "$branch" "info"
    print_status_value "Commit:" "$commit" "normal"
    print_status_value "Latest Tag:" "$latest_tag" "normal"
    print_status_value "Modules:" "$module_count" "normal"
    print_status_value "Operating System:" "$operating_system" "normal"
    print_status_value "Kernel:" "$kernel" "normal"
    print_status_value "Architecture:" "$architecture" "normal"
    print_status_value "Hardware Vendor:" "$hardware_vendor" "normal"
    print_status_value "Hardware Model:" "$hardware_model" "normal"
    print_status_value "License:" "$LABCTL_LICENSE" "normal"
}


show_profiles_summary() {
    load_module profile || return 1

    print_header "LABCTL CONFIGURATION"

    echo "Power selectors:"
    printf "  %-10s %s\n" "work" "balanced"
    printf "  %-10s %s\n" "travel" "power-saver"

    echo
    echo "Components:"
    printf "  %-10s %s\n" "qemu" "QEMU / Libvirt"
    printf "  %-10s %s\n" "docker" "Docker / Containerd"
    printf "  %-10s %s\n" "vmware" "VMware Workstation"
    printf "  %-10s %s\n" "vbox" "VirtualBox"
    printf "  %-10s %s\n" "ai" "Ollama"

    echo
    print_status_value \
        "Current configuration:" \
        "$(profile_saved_name)" \
        "info"

    echo
    echo "Examples:"
    echo "  labctl work"
    echo "  labctl work vmware"
    echo "  labctl work qemu docker"
    echo "  labctl travel"
    echo "  labctl travel qemu"
    echo "  labctl qemu"
    echo "  labctl qemu vmware"
    echo "  labctl qemu vmware docker"
    echo "  labctl docker ai"

    echo
    echo "Status:"
    echo "  labctl profile status"

    echo
    echo "Safety:"
    echo "  Add --dry-run to preview changes"
    echo "  Add --yes for intentional non-interactive use"

    echo
    echo "Module controls:"
    echo "  labctl qemu status"
    echo "  labctl docker status"
    echo "  labctl vmware status"
    echo "  labctl virtualbox status"

    echo
    echo "For complete help:"
    echo "  labctl help"
}

show_help() {
    cat <<'HELP'
LabCTL - Workstation and Lab Control

Usage:
  labctl health
  labctl doctor
  labctl about
  labctl info
  labctl [work|travel] [COMPONENT...] [--dry-run|--yes]
  labctl MODULE ACTION
  labctl modules
  labctl version
  labctl help

General commands:
  health          Show the quick system health summary
  doctor          Run a detailed workstation diagnostic
  about           Show LabCTL and platform information
  info            Alias for about
  modules         List installed modules
  version         Show LabCTL version
  help            Show this help

Examples:
  labctl about
  labctl doctor
  labctl docker status
  labctl gpu status
  labctl network list
  labctl vm list
  labctl vmware status
  labctl ollama status
  labctl libvirt status
  labctl qemu backend
  labctl work qemu docker --dry-run
HELP

    echo
    echo "Available modules:"
    list_modules
}

run_health() {
    if [[ ! -x "$HEALTH_SCRIPT" ]]; then
        print_error "Health check script was not found:"
        printf '%s\n' "$HEALTH_SCRIPT" >&2
        return 1
    fi

    "$HEALTH_SCRIPT" health
}

run_module() {
    local module_name="${1:-}"
    local dispatch_function

    if [[ -z "$module_name" ]]; then
        print_error "No module was specified."
        return 1
    fi

    shift || true
    dispatch_function="${module_name}_dispatch"

    load_module "$module_name" || return 1

    if ! declare -F "$dispatch_function" >/dev/null 2>&1; then
        print_error "Module '$module_name' does not implement:"
        printf '%s\n' "$dispatch_function" >&2
        return 1
    fi

    "$dispatch_function" "$@"
}

main() {
    local command="${1:-profiles}"

    shift || true

    load_module utils || exit 1

    #
    # Combinable LabCTL configuration.
    #
    # Examples:
    #   labctl work
    #   labctl work vmware
    #   labctl qemu vmware
    #   labctl qemu vmware docker
    #
    # Module actions such as:
    #   labctl docker status
    #   labctl vmware status
    # are excluded because "status" is not a configuration token.
    #
    local -a config_tokens=("$command" "$@")
    local token
    local configuration_request=1

    for token in "${config_tokens[@]}"; do
        case "$token" in
            work|travel|qemu|docker|vmware|vbox|ai)
                ;;
            --dry-run|--yes|-y)
                ;;
            *)
                configuration_request=0
                break
                ;;
        esac
    done

    if (( configuration_request )); then
        run_module profile "${config_tokens[@]}"
        return
    fi

    if [[ "$command" =~ ^(qemu|docker|vmware|vbox|ai)$ ]]; then
        local -a components=("$command" "$@")
        local item

        for item in "${components[@]}"; do
            if [[ ! "$item" =~ ^(qemu|docker|vmware|vbox|ai)$ ]]; then
                components=()
                break
            fi
        done

        if (( ${#components[@]} > 0 )); then
            run_module profile "${components[@]}"
            return
        fi
    fi

    case "$command" in
        health|status)
            run_health
            ;;

        doctor)
            run_module doctor "$@"
            ;;

        about|info)
            labctl_about
            ;;

        modules|list-modules)
            print_header "AVAILABLE MODULES"
            list_modules
            ;;

        version|-v|--version)
            echo "labctl $LABCTL_VERSION"
            ;;

        profiles)
            show_profiles_summary
            ;;

        help|-h|--help)
            show_help
            ;;

        work|travel)
            run_module profile "$command" "$@"
            ;;

        vbox)
            run_module profile vbox "$@"
            ;;

        docker)
            if [[ "${1:-}" =~ ^(start|stop|restart|status|ps|logs|restart-container|help|-h|--help)$ ]]; then
                run_module docker "$@"
            else
                run_module profile docker "$@"
            fi
            ;;

        vmware)
            if [[ "${1:-}" =~ ^(start|stop|restart|status|help|-h|--help)$ ]]; then
                run_module vmware "$@"
            else
                run_module profile vmware "$@"
            fi
            ;;

        virtualbox)
            run_module virtualbox "$@"
            ;;

        ai)
            if [[ "${1:-}" =~ ^(start|stop|restart|status|help|-h|--help)$ ]]; then
                run_module ollama "$@"
            else
                run_module profile ai "$@"
            fi
            ;;

        qemu)
            case "${1:-}" in
                status)
                    run_module libvirt status
                    ;;
                start)
                    run_module libvirt start
                    ;;
                stop)
                    run_module libvirt stop
                    ;;
                restart)
                    run_module libvirt restart
                    ;;
                backend)
                    run_module libvirt backend
                    ;;
                help|-h|--help)
                    run_module libvirt help
                    ;;
                *)
                    print_error "Unknown QEMU action: ${1:-}"
                    return 1
                    ;;
            esac
            ;;

        *)
            run_module "$command" "$@"
            ;;
    esac
}

main "$@"
